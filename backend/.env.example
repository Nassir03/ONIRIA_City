APP_NAME=ONIRIA City Backend
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
PORT=7000

# Comma-separated origins. Use exact production domains before deployment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional MySQL connection.
# Leave DATABASE_URL and MYSQL_USER/MYSQL_PASSWORD blank to use seeded demo data.
# For Docker MySQL from the host, use MYSQL_PORT=3307.
# For locally installed MySQL, use MYSQL_PORT=3306.
# DATABASE_URL can be used directly instead of MYSQL_* values.
# Example: mysql://root:your_password@127.0.0.1:3306/oniria_city
DATABASE_URL=mysql+mysqlconnector://root:Nassir%406243@127.0.0.1:3306/oniria_city
DATABASE_MIN_SIZE=1
DATABASE_MAX_SIZE=5
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=oniria_city
MYSQL_USER=root
MYSQL_PASSWORD= Nassir%406243
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120

# Demo token only. Replace for real Meta WhatsApp webhook use.
WHATSAPP_VERIFY_TOKEN=oniria-demo-verify-token
WHATSAPP_APP_SECRET=
