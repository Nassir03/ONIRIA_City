APP_NAME=ONIRIA City Backend
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
PORT=7000

# Comma-separated origins. Use exact production domains before deployment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional MySQL connection. When unset, routes use seeded demo data.
# DATABASE_URL can be used directly, or set the MYSQL_* values below.
# Example: mysql://oniria_app_user:change_me@127.0.0.1:3306/oniria_city
DATABASE_URL=
DATABASE_MIN_SIZE=1
DATABASE_MAX_SIZE=5
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=oniria_city
MYSQL_USER=oniria_app_user
MYSQL_PASSWORD=change_me
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
WHATSAPP_VERIFY_TOKEN=oniria-demo-verify-token
WHATSAPP_APP_SECRET=
