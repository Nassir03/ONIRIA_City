APP_NAME=ONIRIA City Backend
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
PORT=7000

# Comma-separated origins. Use exact production domains before deployment.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Optional MySQL connection. When unset, routes use seeded demo data.
# Example: mysql://oniria_user:oniria_password@127.0.0.1:3306/oniria_city
DATABASE_URL=
DATABASE_MIN_SIZE=1
DATABASE_MAX_SIZE=5

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
