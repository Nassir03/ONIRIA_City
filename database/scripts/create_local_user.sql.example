-- Replace placeholders locally. Do not commit real passwords.
CREATE USER IF NOT EXISTS 'oniria_migration_user'@'%' IDENTIFIED BY '<MIGRATION_PASSWORD>';
GRANT ALL PRIVILEGES ON oniria_city.* TO 'oniria_migration_user'@'%';

CREATE USER IF NOT EXISTS 'oniria_app_user'@'%' IDENTIFIED BY '<APP_PASSWORD>';
GRANT SELECT, INSERT, UPDATE, DELETE, EXECUTE ON oniria_city.* TO 'oniria_app_user'@'%';

CREATE USER IF NOT EXISTS 'oniria_backup_user'@'%' IDENTIFIED BY '<BACKUP_PASSWORD>';
GRANT SELECT, LOCK TABLES, SHOW VIEW, EVENT, TRIGGER ON oniria_city.* TO 'oniria_backup_user'@'%';

FLUSH PRIVILEGES;
